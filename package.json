{
  "name": "rerun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:contracts",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "build:contracts": "cd contracts/rerun && cargo near build non-reproducible-wasm --no-abi && cd ../mock-ft && cargo near build non-reproducible-wasm --no-abi",
    "typecheck": "pnpm -r --if-present typecheck",
    "nearai:hello": "pnpm --filter @rerun/orchestrator nearai:hello",
    "lab:run": "pnpm --filter @rerun/orchestrator lab:run",
    "sandbox:build": "docker build -t rerun-sandbox:python3.11 -f lab/sandbox/python.Dockerfile lab/sandbox && docker build -t rerun-sandbox:r4.4 -f lab/sandbox/r.Dockerfile lab/sandbox",
    "testnet:accounts": "pnpm --filter @rerun/scripts testnet:accounts",
    "deploy:testnet": "pnpm --filter @rerun/scripts deploy:testnet",
    "demo": "pnpm --filter @rerun/scripts demo",
    "seed": "pnpm --filter @rerun/scripts seed",
    "web": "pnpm --filter @rerun/web dev",
    "lab:watch": "pnpm --filter @rerun/orchestrator lab:watch"
  }
}
