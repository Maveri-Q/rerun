{
  "name": "rerun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:contracts",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "build:contracts": "cd contracts/rerun && cargo near build non-reproducible-wasm --no-abi && cd ../mock-ft && cargo near build non-reproducible-wasm --no-abi && cd ../verdict-bet && cargo near build non-reproducible-wasm --no-abi",
    "typecheck": "pnpm -r --if-present typecheck",
    "nearai:hello": "pnpm --filter @rerun/orchestrator nearai:hello",
    "lab:run": "pnpm --filter @rerun/orchestrator lab:run",
    "sandbox:build": "docker build -t rerun-sandbox:python3.11 -f lab/sandbox/python.Dockerfile lab/sandbox && docker build -t rerun-sandbox:r4.4 -f lab/sandbox/r.Dockerfile lab/sandbox",
    "testnet:accounts": "pnpm --filter @rerun/scripts testnet:accounts",
    "deploy:testnet": "pnpm --filter @rerun/scripts deploy:testnet",
    "demo": "pnpm --filter @rerun/scripts demo",
    "seed": "pnpm --filter @rerun/scripts seed",
    "post-real": "pnpm --filter @rerun/scripts post-real",
    "facts": "pnpm --filter @rerun/scripts facts",
    "site-snapshot": "pnpm --filter @rerun/scripts site-snapshot",
    "brand": "pnpm --filter @rerun/scripts brand",
    "scout:account": "pnpm --filter @rerun/scripts scout:account",
    "relayer:account": "pnpm --filter @rerun/scripts relayer:account",
    "relay:check": "pnpm --filter @rerun/scripts relay:check",
    "verdict-bet-demo": "pnpm --filter @rerun/scripts verdict-bet-demo",
    "settle-claim": "pnpm --filter @rerun/scripts settle-claim",
    "verify-claim": "pnpm --filter @rerun/scripts verify-claim",
    "upgrade-contract:testnet": "pnpm --filter @rerun/scripts upgrade-contract",
    "scout": "pnpm --filter @rerun/orchestrator scout",
    "repair-benchmark": "pnpm --filter @rerun/orchestrator repair-benchmark",
    "challenge-demo": "pnpm --filter @rerun/scripts challenge-demo",
    "attack-demo": "pnpm --filter @rerun/scripts attack-demo",
    "judge-demo": "pnpm --filter @rerun/scripts judge-demo",
    "web": "pnpm --filter @rerun/web dev",
    "lab:watch": "pnpm --filter @rerun/orchestrator lab:watch",
    "real-usage": "pnpm --filter @rerun/scripts real-usage",
    "finalize-claims": "pnpm --filter @rerun/scripts finalize-claims",
    "money-demo": "pnpm --filter @rerun/scripts money-demo",
    "readme-results": "pnpm --filter @rerun/scripts readme-results",
    "phala:register": "pnpm --filter @rerun/scripts phala:register"
  }
}
