# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- NEAR AI Cloud (private inference) ---
NEARAI_CLOUD_API_KEY=
NEARAI_CLOUD_BASE_URL=https://cloud-api.near.ai
# Primary private TEE model (owned_by "nearai" in /v1/models) and a different one for independent re-runs
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_RERUN_MODEL=Qwen/Qwen3.8-27B
# Cost guards for the single LLM wrapper
LLM_MAX_TOKENS_PER_CALL=2000
LLM_MAX_CALLS_PER_RUN=12
LLM_DAILY_USD_CAP=1.00
# 1 = never call the network for completions (tests, CI)
MOCK_LLM=0

# --- Lab ---
# X25519 key private-data owners encrypt to (hex). Empty = a throwaway key per process (local demos).
LAB_ENC_PUBLIC_KEY=
LAB_ENC_PRIVATE_KEY=
# Base URL for logs and reports referenced by receipts
LAB_PUBLIC_URL=
# Only needed if docker is not on PATH
DOCKER_BIN=

# --- NEAR networks ---
NETWORKS=testnet
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com
NEAR_TESTNET_FAUCET_URL=https://helper.nearprotocol.com/account

# Testnet accounts (written by `pnpm testnet:accounts` into .env.testnet, gitignored)
TESTNET_OWNER_ACCOUNT=
TESTNET_OWNER_PRIVATE_KEY=
TESTNET_LAB_ACCOUNT=
TESTNET_LAB_PRIVATE_KEY=
TESTNET_CONTRACT_ACCOUNT=
TESTNET_FT_ACCOUNT=

# Mainnet (only after the human approves)
MAINNET_CONTRACT_ACCOUNT=
MAINNET_LAB_ACCOUNT=
MAINNET_LAB_PRIVATE_KEY=
